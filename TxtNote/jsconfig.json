{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@shared/types": ["types/index.ts"],
      "@shared/services": ["services/index.ts"],
      "@services/*": ["services/*"],
      "@app/*": ["frontend/src/*"],
      "@/*": ["frontend/src/*"]
    }
  },
  "include": ["frontend/src", "services", "types"],
  "exclude": ["node_modules", "backend"]
}