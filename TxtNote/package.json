{
  "name": "txtnote",
  "private": true,
  "version": "0.1.0",
  "description": "TxtNote desktop app",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "preview": "npm run preview --prefix frontend",
    "tauri": "node scripts/tauri.mjs",
    "desktop": "node scripts/tauri.mjs dev",
    "desktop:build": "node scripts/tauri.mjs build",
    "updates:serve": "node scripts/serve-updates.mjs",
    "verify:encrypted-db": "node scripts/verify-encrypted-db.mjs",
    "test": "npm test --prefix frontend && node --test services/local/*.test.js services/wallet/*.test.js services/crypto/*.test.js",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "desktop:build:unsigned": "node scripts/release.mjs --unsigned",
    "test:release": "node --test scripts/release-verification.test.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "viem": "^2.38.0"
  }
}
