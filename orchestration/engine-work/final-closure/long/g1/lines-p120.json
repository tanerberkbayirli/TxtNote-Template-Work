 "117": {
  "k": 0.988170854627025,
  "lines": [
   {
    "top": 137.6,
    "bottom": 151.9,
    "id": "docx-25341",
    "text": "BÖLÜM: "
   },
   {
    "top": 178,
    "bottom": 190.8,
    "id": "docx-25351",
    "text": "Çok kriterli karar verme yöntemlerinden "
   },
   {
    "top": 198.7,
    "bottom": 211.5,
    "id": "docx-25351",
    "text": "SYTZ yönetimindeki engeller olarak nitel"
   },
   {
    "top": 219.4,
    "bottom": 232.2,
    "id": "docx-25351",
    "text": "sırasını belirlemek ve bu unsurlar arası"
   },
   {
    "top": 240.1,
    "bottom": 252.9,
    "id": "docx-25351",
    "text": "kullanılmıştır. Bu bölümde araştırmanın "
   },
   {
    "top": 260.8,
    "bottom": 273.6,
    "id": "docx-25351",
    "text": "önem dereceleri ve etki düzeyine göre ik"
   },
   {
    "top": 287.5,
    "bottom": 300.3,
    "id": "docx-25354",
    "text": "Bu bölümde, “"
   },
   {
    "top": 308.2,
    "bottom": 320.9,
    "id": "docx-25372",
    "text": "engeller nelerdir?"
   },
   {
    "top": 328.9,
    "bottom": 341.6,
    "id": "docx-25376",
    "text": "karşılaşılan engeller yapısal olarak bir"
   },
   {
    "top": 349.6,
    "bottom": 362.3,
    "id": "docx-25380",
    "text": "olarak oluşturulan araştırma sonuçları a"
   },
   {
    "top": 376.3,
    "bottom": 389,
    "id": "docx-25383",
    "text": "Bu bölümün ilk alt başlığı araştırma bul"
   },
   {
    "top": 397,
    "bottom": 409.7,
    "id": "docx-25387",
    "text": "ver"
   },
   {
    "top": 417.7,
    "bottom": 430.4,
    "id": "docx-25391",
    "text": "sonraki araştırmalara, uygulamacılara ve"
   },
   {
    "top": 438.4,
    "bottom": 451.1,
    "id": "docx-25391",
    "text": "verilmiştir."
   },
   {
    "top": 471.1,
    "bottom": 485.3,
    "id": "docx-25395",
    "text": "Bulgular"
   },
   {
    "top": 502.4,
    "bottom": 515.2,
    "id": "docx-25400",
    "text": "Önem derecelerine göre SYTZ yönetimindek"
   },
   {
    "top": 534.2,
    "bottom": 546.9,
    "id": "docx-25408",
    "text": "DEMATEL yöntemine ait aşamaların ve anal"
   },
   {
    "top": 554.9,
    "bottom": 567.6,
    "id": "docx-25410",
    "text": "SYTZ yönetiminde KOBİ’lerdeki engeller “"
   },
   {
    "top": 581.6,
    "bottom": 594.3,
    "id": "docx-25417",
    "text": "1) Stratejiler (I)"
   },
   {
    "top": 608.3,
    "bottom": 621,
    "id": "docx-25420",
    "text": "2) Fiyat / Maliyet (H)"
   },
   {
    "top": 635,
    "bottom": 647.7,
    "id": "docx-25423",
    "text": "3) Ekonomi / Finans (D)"
   },
   {
    "top": 661.7,
    "bottom": 674.4,
    "id": "docx-25426",
    "text": "4) Üst Yönetim (C)"
   },
   {
    "top": 688.4,
    "bottom": 701.1,
    "id": "docx-25429",
    "text": "5) Kurum / Kurum Kültürü / Değişim Yönet"
   },
   {
    "top": 715,
    "bottom": 727.8,
    "id": "docx-25432",
    "text": "6) Operasyonel (J)"
   }
  ]
 },
