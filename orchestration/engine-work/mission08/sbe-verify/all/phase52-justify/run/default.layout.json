          {
            "id": "main:paragraph:2",
            "kind": "paragraph",
            "sectionId": "main",
            "text": "J03-1 Bu çalışmada elde edilen veriler değerlendirilmiş ve sonuçlar ayrıntılı biçimde raporlanmıştır.",
